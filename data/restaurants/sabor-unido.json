  "about": [
    {
      "en": "Sabor Unido is a family-run restaurant serving homemade Brazilian and Portuguese food in the Ironbound.",
      "es": "Sabor Unido es un restaurante familiar de comida brasileña y portuguesa casera en el Ironbound.",
      "pt": "O Sabor Unido é um restaurante familiar de comida brasileira e portuguesa caseira no Ironbound."
    },
    {
      "en": "The Jefferson Street room had been home to Portuguese restaurants for 30 years before the family, from São Paulo, took over, kept Portuguese dishes, and added Brazilian ones. Luiz Campos is the manager, Orlando is on the business side, and Silvana is the chef. The family emigrated from Brazil in 2001.",
