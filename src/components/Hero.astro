---
import Lang from "./Lang.astro";
import { t } from "../i18n.mjs";

const { restaurant: r, lang, tel, directions } = Astro.props;
const variant = r.hero.variant;
---

<header class={`hero hero-${variant}`} id="top">
  {
    variant === "marquee" && (
      <div class="marquee-band">
        <h1>{r.name}</h1>
      </div>
    )
  }
  {
    variant === "butcher" && (
      <div class="slab">
        <h1>{r.shortName}</h1>
      </div>
    )
  }
  {
    variant === "poster" && (
      <div class="poster-sheet">
        <h1>{r.shortName}</h1>
        <p class="dek">
          <Lang text={r.hero.dek} />
        </p>
        <p class="hours-now" data-hours-status>
          {t(lang, "today")}
        </p>
        <div class="cta-row">
          <a class="button" href="#menu">
            <span data-i18n="seeMenu">{t(lang, "seeMenu")}</span>
          </a>
          <a class="button secondary" href={tel}>
            <span data-i18n="call">{t(lang, "call")}</span> {r.phoneDisplay}
          </a>
        </div>
      </div>
    )
  }
  {
    variant === "tide" && (
      <div class="tide-wrap">
        <h1>{r.name}</h1>
        <div class="tide-panel">
          <p class="dek">
            <Lang text={r.hero.dek} />
          </p>
          <p class="hours-now" data-hours-status>
            {t(lang, "today")}
          </p>
          <div class="cta-row">
            <a class="button" href="#menu">
              <span data-i18n="seeMenu">{t(lang, "seeMenu")}</span>
            </a>
            <a class="button secondary" href={tel}>
              <span data-i18n="call">{t(lang, "call")}</span> {r.phoneDisplay}
            </a>
          </div>
        </div>
      </div>
    )
  }
  {
    variant === "letterpress" && (
      <div class="press-card">
        <h1>{r.name}</h1>
        <p class="dek">
          <Lang text={r.hero.dek} />
        </p>
        <p class="hours-now" data-hours-status>
          {t(lang, "today")}
        </p>
        <div class="cta-row">
          <a class="button" href="#menu">
            <span data-i18n="seeMenu">{t(lang, "seeMenu")}</span>
          </a>
          <a class="button secondary" href={tel}>
            <span data-i18n="call">{t(lang, "call")}</span> {r.phoneDisplay}
          </a>
        </div>
      </div>
    )
  }
  {
    variant === "chapel" && (
      <div class="chapel-stack">
        <h1>{r.name}</h1>
        <p class="dek">
          <Lang text={r.hero.dek} />
        </p>
        <p class="hours-now" data-hours-status>
          {t(lang, "today")}
        </p>
        <div class="cta-row">
          <a class="button" href={tel}>
            <span data-i18n="call">{t(lang, "call")}</span> {r.phoneDisplay}
          </a>
          <a class="button secondary" href={directions}>
            <span data-i18n="directions">{t(lang, "directions")}</span>
          </a>
        </div>
      </div>
    )
  }

  {
    variant !== "poster" && variant !== "tide" && variant !== "letterpress" && variant !== "chapel" && (
      <div class={variant === "marquee" ? "marquee-rest" : variant === "butcher" ? "butcher-rest" : variant === "counter" ? "window" : "hero-inner"}>
        {variant !== "marquee" && variant !== "butcher" && <h1>{r.name}</h1>}
        {
          variant === "column" ? (
            <div class="split">
              <div>
                <p class="dek">
                  <Lang text={r.hero.dek} />
                </p>
                <p class="hours-now" data-hours-status>
                  {t(lang, "today")}
                </p>
                <div class="cta-row">
                  <a class="button" href="#order">
                    <span data-i18n="orderPickup">{t(lang, "orderPickup")}</span>
                  </a>
                  <a class="button secondary" href={tel}>
                    <span data-i18n="call">{t(lang, "call")}</span> {r.phoneDisplay}
                  </a>
                </div>
              </div>
              {
                r.hero.aside && (
                  <aside class="special">
                    <h2>
                      <Lang text={r.hero.aside.title} />
                    </h2>
                    <p>
                      <Lang text={r.hero.aside.body} block />
                    </p>
                  </aside>
                )
              }
            </div>
          ) : (
            <>
              {variant === "butcher" && (
                <p class="dek">
                  <Lang text={r.hero.dek} />
                </p>
              )}
              {variant !== "butcher" && (
                <p class="dek">
                  <Lang text={r.hero.dek} />
                </p>
              )}
              <p class="hours-now" data-hours-status>
                {t(lang, "today")}
              </p>
              <div class={variant === "cafeteria" ? "ticket" : "cta-row"}>
                {variant === "cafeteria" && (
                  <p class="fine">
                    {r.address.street}
                    <br />
                    {r.address.city}, {r.address.region} {r.address.postalCode}
                  </p>
                )}
                <div class="cta-row">
                  <a class="button" href="#menu">
                    <span data-i18n="seeMenu">{t(lang, "seeMenu")}</span>
                  </a>
                  <a class="button secondary" href={tel}>
                    <span data-i18n="call">{t(lang, "call")}</span> {r.phoneDisplay}
                  </a>
                  <a class="button secondary" href={directions}>
                    <span data-i18n="directions">{t(lang, "directions")}</span>
                  </a>
                </div>
              </div>
            </>
          )
        }
      </div>
    )
  }
</header>
