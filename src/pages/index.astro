---
import { loadRestaurants } from "../lib/restaurants.mjs";
import "../styles/global.css";

const restaurants = loadRestaurants();
const base = import.meta.env.BASE_URL;
const title = "Newark restaurant demos";
const description = "Demo preview sites built for independent restaurants in Newark, New Jersey.";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(base, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL(`${base}og/index.svg`, Astro.site).toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;650&family=Source+Serif+4:opsz,wght@8..60,560&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="index-page" data-index>
    <a class="skip" href="#content">Skip to content</a>
    <main id="content">
      <h1>Demo sites for Newark restaurants</h1>
      <p class="dek">
        Each page is a preview built for that one restaurant: its own type, colors, and menu notes. Prices are real only where a public menu said so. Sample menus are labeled on the page.
      </p>
      <ul class="directory">
        {
          restaurants.map((restaurant) => (
            <li>
              <a href={`${base}${restaurant.slug}/`}>{restaurant.name}</a>
              <p>
                {restaurant.cuisineLabel.en}. {restaurant.address.street}, {restaurant.address.city}.
              </p>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
